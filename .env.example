# Server binding
HOST=0.0.0.0
PORT=4173
AGENT_SERVER_PORT=4173

# Optional: custom data directory relative to project root
AGENT_DATA_DIR=data/local

# Optional: seed the first admin-grade agent token. If omitted, the server writes one to data/local/agent-bootstrap-token.txt
AGENT_BOOTSTRAP_TOKEN=

# Optional: default API key fallback for Gemini models
VITE_GEMINI_API_KEY=

# Optional: default API key fallback for OpenAI-compatible models
VITE_OPENAI_API_KEY=

# Optional: generic fallback used when provider-specific key is absent
VITE_API_KEY=
